{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tableboat",
  "version": "0.1.0",
  "identifier": "app.tableboat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tableboat",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Tableboat",
    "copyright": "Copyright (c) 2026 Yash Desai. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "A small, fast database client",
    "longDescription": "Tableboat: MySQL, MariaDB, SQLite and MongoDB client with a SQL editor, results grid with safe editing, and Claude Code built in."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBNkFCMzZBMjlFNzMxMzgKUldRNE1lY3Bhck5xbXBmVmdVOTRhaVdKaHpzcUY4WWhVVDdOaDNtYkRjTmp2WkpHaXlaNjV5cDAK",
      "endpoints": [
        "https://github.com/yash-desai-naik/tableboat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
